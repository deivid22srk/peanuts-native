<?xml version="1.0" encoding="utf-8"?>
<!-- Dark mode: a warm night (roasted peel browns) with the same banana yellow. Contrast ratios name the pair each color is drawn in (see values/colors.xml) -->
<resources>
    <color name="bn_bg">#FF17120C</color>            <!-- the screen (text on bg 16.6:1, secondary text on bg 9.3:1) -->
    <color name="bn_card">#FF241C14</color>          <!-- cards and dialogs (text on card 15.0:1, secondary text on card 8.4:1) -->
    <color name="bn_card_stroke">#FF3A2E20</color>   <!-- hairline card edge, dividers, progress track -->
    <color name="bn_tint">#FF3A2D17</color>          <!-- tonal buttons, icon tiles, chips (text on tint 12.0:1, accent on tint 9.4:1) -->
    <color name="bn_banana">#FFFFD43B</color>        <!-- primary buttons (on_banana on banana 10.0:1) -->
    <color name="bn_banana_deep">#FFF2B705</color>   <!-- pressed primary accent, strong borders on warning surfaces -->
    <color name="bn_on_banana">#FF3B2611</color>     <!-- text on banana yellow (10.0:1; both modes) -->
    <color name="bn_text">#FFFFF1D2</color>          <!-- body text (15.0:1 on card, 16.6:1 on bg, 12.0:1 on tint) -->
    <color name="bn_text_2">#FFCDB48C</color>        <!-- secondary text (8.4:1 on card, 9.3:1 on bg, 6.7:1 on tint) -->
    <color name="bn_accent">#FFFFD43B</color>        <!-- the banana itself as the accent on dark (11.8:1 on card, 13.1:1 on bg, 9.4:1 on tint) -->
    <color name="bn_leaf">#FF7FC79A</color>          <!-- the brand green, lightened for dark (8.4:1 on card) -->
    <color name="bn_badge">#FF1E5B3A</color>         <!-- the header badge's circle stays the launcher icon's deep green in both modes (see values/colors.xml) -->
    <color name="bn_on_leaf">#FF10241A</color>       <!-- text on leaf green (8.2:1) -->
    <color name="bn_danger">#FFFF9670</color>        <!-- error text, danger button label (7.9:1 on card, 7.0:1 on danger_tint, 6.0:1 on warn_tint) -->
    <color name="bn_danger_tint">#FF3D2016</color>   <!-- danger button container (text on it 7.0:1) -->
    <color name="bn_warn_tint">#FF3F3014</color>     <!-- warning container, warning chips (text on it 11.4:1) -->
    <color name="bn_ok">#FF7FC79A</color>            <!-- success text: shares the leaf green (8.4:1 on card, 6.8:1 on ok_tint) -->
    <color name="bn_warn">#FFFFC85C</color>          <!-- warning text (10.9:1 on card, 8.3:1 on warn_tint) -->
    <color name="bn_ok_tint">#FF1C3325</color>       <!-- success container: the Readiness check's PASS rows (see values/colors.xml; ok text on it 6.8:1) -->
    <color name="bn_control_ripple">#33FFF1D2</color><!-- theme widget highlight/ripple (warm white at 20%) -->
</resources>
